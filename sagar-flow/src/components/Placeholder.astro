---
// Shows a real image when `src` is set, otherwise a labelled placeholder box.
interface Props { label: string; src?: string; alt?: string; ratio?: string; class?: string; eager?: boolean }
const { label, src, alt, ratio = "16 / 10", class: cls, eager = false } = Astro.props;
---
{src
  ? <img class={cls} src={src} alt={alt ?? ""} style={`aspect-ratio:${ratio};object-fit:cover;width:100%;border-radius:var(--r-md)`} loading={eager ? "eager" : "lazy"} decoding="async" />
  : <div class:list={["ph", cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Placeholder: ${label}`}>{label}</div>}
