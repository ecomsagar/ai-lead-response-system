---
// Loads Google Analytics / Google Ads / Meta Pixel only when IDs are set in src/config/site.ts.
import { site } from "../config/site";
const { googleAnalyticsId: ga, metaPixelId: px, googleAdsId: ads } = site.analytics;
const gtagId = ga || ads;
---
{gtagId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
    <script is:inline define:vars={{ ga, ads }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag("js", new Date());
      if (ga) gtag("config", ga);
      if (ads) gtag("config", ads);
    </script>
  </>
)}
{px && (
  <script is:inline define:vars={{ px }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', px); fbq('track', 'PageView');
  </script>
)}
<script is:inline>
  // Any link with data-track="EventName" sends that event to Meta Pixel and Google.
  // Events used: Contact (WhatsApp), Schedule (booking), InitiateCheckout (package buttons).
  document.addEventListener("click", function (e) {
    var el = e.target.closest && e.target.closest("[data-track]");
    if (!el) return;
    var ev = el.getAttribute("data-track"), plan = el.getAttribute("data-plan") || undefined;
    if (window.fbq) fbq("track", ev, plan ? { content_name: plan } : {});
    if (window.gtag) gtag("event", ev.toLowerCase(), plan ? { plan: plan } : {});
  });
</script>
