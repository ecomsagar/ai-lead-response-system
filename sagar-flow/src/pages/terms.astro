import { site } from "../config/site";
---
<TextPage title="Terms | Sagar Flow" heading="Terms of service" description="The simple terms for working with Sagar Flow." intro="Plain-English terms. Please read before you buy. [REVIEW WITH A LAWYER BEFORE LAUNCH]">
  <h2>Setup packages</h2>
  <p>Setup packages (Starter, Store, Full) are one-time payments. Work starts once we receive payment and the documents and product details we ask for.</p>
  <p>We aim to go live within 30 days. Delays from missing documents, platform approvals (Noon, Amazon, Meta, Google) or late product photos can extend this.</p>
  <h2>Growth Partner subscription</h2>
  <ul>
    <li>Growth Partner is billed monthly.</li>
    <li>The minimum commitment is 6 months. After 6 months you can cancel any time with [NUMBER] days notice.</li>
    <li>Amazon account setup and listings are only included while you are a Growth Partner.</li>
    <li>Founding-offer prices stay the same for as long as the subscription stays active.</li>
  </ul>
  <h2>What prices do not include</h2>
  <p>Prices exclude VAT, ad budget and platform fees (for example Noon, Amazon, Shopify, domain and app fees). You pay those directly to the platform.</p>
  <h2>Results</h2>
  <p>We do the work carefully and report honestly. Sales depend on many things we don't control, such as product, price and market. We don't guarantee a number of sales.</p>
  <h2>Refunds</h2>
  <p>[YOUR REFUND POLICY: e.g. full refund before work starts; no refund after accounts are created.]</p>
  <h2>Contact</h2>
  <p>{site.name}, {site.city}, UAE · {site.email} · WhatsApp {site.whatsappDisplay}</p>
</TextPage>
