---
import Base from "../layouts/Base.astro";
import CaseCard from "../components/CaseCard.astro";
import CtaBand from "../components/CtaBand.astro";
import WorkEmpty from "../components/WorkEmpty.astro";
import { getPublishedCaseStudies } from "../lib/caseStudies";

const all = await getPublishedCaseStudies();
const present = new Set(all.map((e) => e.data.category));
const filters = [
  { id: "all", label: "All" },
  { id: "noon", label: "Noon" },
  { id: "amazon", label: "Amazon" },
  { id: "ads", label: "Ads" },
  { id: "website", label: "Website" },
  { id: "automation", label: "Automation" },
].filter((f) => f.id === "all" || present.has(f.id as any));
---
<Base
  title="Portfolio | Noon, Amazon UAE & Shopify Setups | Sagar Flow"
  description="See how Sagar Flow sets up Noon seller accounts, Amazon UAE listings, Shopify stores, ads and automation for small businesses in Dubai and the UAE."
>
  <section class="p-hero dark">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1>The work, not just the promises.</h1>
      <p class="lead muted">Real setups for UAE businesses. Every number on this page comes from a real account.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {all.length > 0 ? (
        <>
          {filters.length > 2 && (
            <div class="filters" role="group" aria-label="Filter case studies">
              {filters.map((f, i) => <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>{f.label}</button>)}
            </div>
          )}
          <div class="grid" id="case-grid">{all.map((e) => <CaseCard entry={e} />)}</div>
          <p class="empty muted" hidden>No case studies in this category yet.</p>
        </>
      ) : <WorkEmpty />}
    </div>
  </section>

  <CtaBand title={all.length > 0 ? "Want results like these?" : undefined} />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const cards = document.querySelectorAll<HTMLElement>("#case-grid [data-cat]");
  const empty = document.querySelector<HTMLElement>(".empty");
  buttons.forEach((b) => b.addEventListener("click", () => {
    const f = b.dataset.filter;
    buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    let shown = 0;
    cards.forEach((c) => { const ok = f === "all" || c.dataset.cat === f; c.hidden = !ok; if (ok) shown++; });
    if (empty) empty.hidden = shown > 0;
  }));

</script>

<style>
  .p-hero { padding-block: 56px 64px; }
  @media (min-width: 900px) { .p-hero { padding-block: 96px; } }
  .p-hero .wrap { display: grid; gap: 20px; }
  .p-hero .eyebrow { margin-bottom: 0; }
  .p-hero h1 { max-width: 15ch; }

  .filters { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 32px; scrollbar-width: none; }
  .filter { flex: none; min-height: 44px; padding: 0 18px; border-radius: 99px; border: 1px solid var(--line); background: var(--card); font-weight: 600; cursor: pointer; transition: all .15s; }
  .filter:hover { border-color: var(--ink); }
  .filter[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .grid { display: grid; gap: 20px; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .grid [hidden] { display: none !important; }

</style>
