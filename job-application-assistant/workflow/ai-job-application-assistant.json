    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert career coach and professional resume writer.\n\nBelow is a JOB POST and a candidate's RESUME. Write application materials tailored to this exact job.\n\nRULES:\n- Use ONLY facts found in the resume. Never invent jobs, degrees, numbers or skills.\n- Match the language and keywords of the job post where the resume genuinely supports it.\n- Professional, confident, human tone. No clichés like \"I am writing to express my interest\".\n- Cover letter: 250-350 words, 3-4 paragraphs, starts with \"Dear Hiring Manager,\" and ends with \"Sincerely,\" followed by the candidate's name ({{ $json.name }}). Separate paragraphs with a blank line.\n- Resume summary: 3-4 sentences (60-90 words), written in third-person-free resume style (no \"I\").\n\nReturn ONLY valid JSON, no markdown, in exactly this shape:\n{\"job_title\": \"...\", \"company\": \"... or empty string if not found\", \"resume_summary\": \"...\", \"cover_letter\": \"...\"}\n\n=== JOB POST ===\n{{ $json.job_post }}\n\n=== RESUME ===\n{{ $json.resume_text }}"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        -20,
        -100
      ],
      "id": "1b45a2ed-5731-4de0-bb48-be7a7a169047",
      "name": "Write Cover Letter & Summary",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.6
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -20,
        120
      ],
      "id": "4943110d-bc49-48b8-ae3c-77b59198787b",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "// Parses the AI's JSON reply and builds the HTML that Gotenberg turns into a PDF.\nconst raw = String($input.first().json.text || '');\nconst user = $('Prepare Data').first().json;\n\nconst cleaned = raw.replace(/```json|```/gi, '').trim();\nconst start = cleaned.indexOf('{');\nconst end = cleaned.lastIndexOf('}');\nif (start === -1 || end === -1) {\n  throw new Error('AI did not return JSON. Raw reply: ' + raw.slice(0, 300));\n}\nconst ai = JSON.parse(cleaned.slice(start, end + 1));\nif (!ai.cover_letter || !ai.resume_summary) {\n  throw new Error('AI reply is missing cover_letter or resume_summary');\n}\n\nconst esc = (s) => String(s || '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst paragraphs = (s) => String(s).split(/\\n\\s*\\n/).map(p => p.trim()).filter(Boolean)\n  .map(p => `<p>${esc(p).replace(/\\n/g, '<br>')}</p>`).join('\\n');\n\nconst jobTitle = ai.job_title || 'the role';\nconst company = ai.company || '';\nconst today = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });\n\nconst html = `<!doctype html>\n<html><head><meta charset=\"utf-8\"><style>\n  @page { size: A4; margin: 22mm 20mm; }\n  body { font-family: Georgia, 'Times New Roman', serif; color: #1f2937; font-size: 11.5pt; line-height: 1.6; }\n  .head { border-bottom: 2px solid #1e3a8a; padding-bottom: 10px; margin-bottom: 22px; }\n  .name { font-size: 22pt; font-weight: bold; color: #1e3a8a; margin: 0; }\n  .meta { font-size: 10pt; color: #6b7280; margin-top: 4px; }\n  h2 { font-family: Arial, sans-serif; font-size: 10pt; letter-spacing: .12em; text-transform: uppercase; color: #1e3a8a; margin: 0 0 10px; }\n  .summary { background: #eff6ff; border-left: 4px solid #1e3a8a; padding: 12px 16px; margin-bottom: 28px; }\n  .summary p { margin: 0; }\n  p { margin: 0 0 12px; }\n  .foot { margin-top: 30px; font-size: 8.5pt; color: #9ca3af; text-align: center; }\n</style></head><body>\n  <div class=\"head\">\n    <p class=\"name\">${esc(user.name)}</p>\n    <div class=\"meta\">${esc(user.email)} &nbsp;·&nbsp; Application for ${esc(jobTitle)}${company ? ' at ' + esc(company) : ''} &nbsp;·&nbsp; ${today}</div>\n  </div>\n  <h2>Resume Summary</h2>\n  <div class=\"summary\">${paragraphs(ai.resume_summary)}</div>\n  <h2>Cover Letter</h2>\n  ${paragraphs(ai.cover_letter)}\n  <div class=\"foot\">Generated by AI Job Application Assistant</div>\n</body></html>`;\n\nreturn [{\n  json: {\n    name: user.name,\n    email: user.email,\n    job_title: jobTitle,\n    company,\n    resume_summary: ai.resume_summary,\n    cover_letter: ai.cover_letter,\n    html,\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        -100
